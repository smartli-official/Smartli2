# NVIDIA NIM API Key
# Get your key from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenRouter API Key (optional, for non-NVIDIA models)
OPENROUTER_API_KEY=your_openrouter_key_here

# Clerk Authentication
# Get your keys from: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Naga AI — speech-to-text (Whisper) via server-side /api/transcribe route
# Get your key from: https://naga.ac/
# NEVER use a NEXT_PUBLIC_ prefix for this key — it must stay server-side.
NAGA_API_KEY=your_naga_api_key_here
NAGA_TRANSCRIPTION_MODEL=whisper-large-v3:free

# Exa Search — web grounding for the "Search" toggle in chat
# Get your key from: https://dashboard.exa.ai/
# NEVER use a NEXT_PUBLIC_ prefix for this key — it must stay server-side.
EXA_API_KEY=your_exa_api_key_here

# Clerk Webhook
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_signing_secret

# Razorpay (Test Mode keys start with rzp_test_)
# NEVER use a NEXT_PUBLIC_ prefix for the secret — it must stay server-side.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Key ID is public by design (used by Checkout.js in the browser):
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Razorpay Plans for recurring subscriptions (one per tier x billing period).
# Create with `node scripts/create-razorpay-plans.mjs` (test mode) and paste
# the resulting plan_xxx IDs here. Live mode needs its own 4 plans.
RAZORPAY_PLAN_SCHOLAR_MONTHLY=plan_your_scholar_monthly_id
RAZORPAY_PLAN_SCHOLAR_YEARLY=plan_your_scholar_yearly_id
RAZORPAY_PLAN_LUMINARY_MONTHLY=plan_your_luminary_monthly_id
RAZORPAY_PLAN_LUMINARY_YEARLY=plan_your_luminary_yearly_id

# Webhook signing secret for POST /api/webhooks/razorpay (Dashboard →
# Settings → Webhooks). Powers renewal/cancel lifecycle sync.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Note: Copy this file to .env.local and fill in your actual keys
# .env.local is gitignored and won't be committed to version control
